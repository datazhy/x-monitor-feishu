# ============================================================
# X 博主推文监控 -> 飞书推送  环境变量
# 复制本文件为 .env 并填入真实值： cp .env.example .env
# ============================================================

# ---- Web 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
# Webhook 路径里的长随机 secret（>=24 位）。生成： openssl rand -hex 24
WEBHOOK_SECRET=CHANGE_ME_long_random_secret

# ---- HTTPS 入口（Caddy + Cloudflare DNS-01，独立端口，不碰 80/443）----
# 给 webhook 用的域名（需在 Cloudflare 托管），如 hook.example.com
DOMAIN=hook.example.com
# 对外端口（webhook URL = https://${DOMAIN}:${WEBHOOK_PORT}/webhook/...）
WEBHOOK_PORT=8443
# Cloudflare API Token（需 Zone:DNS:Edit 权限），Caddy 用它做 DNS-01 自动签证书
CF_API_TOKEN=CHANGE_ME_cloudflare_token
# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# 可选：若 TwitterAPI.io 支持自定义请求头/签名，填这里做二次校验（留空则跳过）
WEBHOOK_HEADER_NAME=
WEBHOOK_HEADER_VALUE=

# ---- 数据库 ----
DB_PATH=./data/monitor.db

# ---- TwitterAPI.io ----
TWITTERAPI_BASE_URL=https://api.twitterapi.io
TWITTERAPI_KEY=CHANGE_ME_twitterapi_key
# 单条规则检查间隔（秒）。本方案：600 = 10 分钟
RULE_INTERVAL_SECONDS=600

# ---- 飞书（Feishu / Lark）自定义机器人 ----
# 机器人 webhook 地址（群设置 -> 添加机器人 -> 自定义机器人 复制）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME
# 若机器人开启了“签名校验”，填入密钥；否则留空
FEISHU_SECRET=

# 管理员告警发送到的飞书机器人（可与上面相同，也可单独建一个告警群）
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_ALERT_SECRET=

# ---- Apprise（未来扩展渠道，可留空） ----
# 多个 URL 用逗号分隔，例如： tgram://bottoken/chatid,mailto://user:pass@gmail.com
APPRISE_URLS=

# 按博主分流到专属飞书群（JSON，可留空）。命中的博主只进专属群，不进主群；早报仍统计全部。
# FEISHU_ROUTES=[{"handles":["someuser"],"url":"https://open.feishu.cn/open-apis/bot/v2/hook/xxx","secret":"yyy"}]
FEISHU_ROUTES=

# ---- OpenAI（翻译 + AI 总结，gpt-4o）----
OPENAI_API_KEY=CHANGE_ME_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# 直连不通时填代理（如走服务器 xray： http://127.0.0.1:xxxx），留空则直连
OPENAI_PROXY=
# AI 总结触发：正文非空白字符数 > 此值
AI_SUMMARY_MIN_CHARS=100
# 去重账本上限：tweets 表最多保留条数
PUSHED_RETENTION=5000

# ---- 昨日信号 早报（DeepSeek 预处理 + gpt-5.4 写作）----
DEEPSEEK_API_KEY=CHANGE_ME_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
REPORT_MODEL=gpt-5.4
REPORT_ENABLED=true
REPORT_SELECT_MAX=80
REPORT_TREND_DAYS=7
REPORT_HOUR_BEIJING=9

# ---- 成本核算 ----
# 覆盖模型单价（$/1M tokens），按账单校准：{"gpt-5.4":[1.25,10],"deepseek-v4-flash":[0.27,1.1]}
LLM_PRICES=
TWITTERAPI_TWEET_PRICE=0.15
TWITTERAPI_PROFILE_PRICE=0.18
# 成本报告推送间隔（天）
COST_REPORT_DAYS=7

# ---- 服务器流量/资源监控（可选，scripts/server_monitor.py，用宿主机 cron 跑）----
# KiwiVM 面板的 VEID 与 API Key（getServiceInfo 计费口径）
KIWIVM_VEID=
KIWIVM_API_KEY=
# 流量跨过百分比阈值时各推一次告警
BANDWIDTH_WARN_PCT=80
BANDWIDTH_CRIT_PCT=95
# 可选：手动覆盖月流量配额（字节），留空则用面板值
BANDWIDTH_LIMIT_BYTES=

# ---- 推送重试 ----
PUSH_MAX_RETRIES=5
# 递增退避（分钟），逗号分隔，对应每次重试的等待时间
PUSH_RETRY_BACKOFF_MINUTES=1,5,15,30,60

# ---- 定时任务 ----
# 每天补漏次数（方案：2 次）
BACKFILL_TIMES_PER_DAY=2
# 心跳检查 cron（每天 1 次，默认每天 09:00）
HEARTBEAT_CRON_HOUR=9
HEARTBEAT_CRON_MINUTE=0
# 成本/余额告警阈值（美元）
BALANCE_ALERT_THRESHOLD=2.0

# ---- 服务器流量+资源监控（scripts/server_monitor.py，KiwiVM API）----
# KiwiVM 面板 -> API -> Enable API 获取
KIWIVM_VEID=
KIWIVM_API_KEY=
# 流量告警阈值（% of 月配额），跨档各推一次
BANDWIDTH_WARN_PCT=80
BANDWIDTH_CRIT_PCT=95
# 留空=用 KiwiVM 返回的 plan_monthly_data；如需强制自定义月配额可填字节数
BANDWIDTH_LIMIT_BYTES=

# ---- 日志 ----
LOG_LEVEL=INFO
